{
  "opensop": "0.9.1",
  "name": "dev-loop",
  "version": "1.0.0",
  "description": "A full agentic dev loop: plan, a fresh critique, a revised plan, workers building its units in order, a mechanical test gate, an adversarial review (first cycle), and a fresh rating. While BLOCKING or MAJOR findings stand, a fix round turns them into new units and the next rating judges only the fix (a delta). ponytail: the review is not re-run on fix rounds; re-run it when a fix changes the approach.",
  "inputs": {
    "workdir": "",
    "request": "",
    "request_file": "",
    "test_command": "",
    "planner": "claude-code:claude-opus-5-5",
    "critic": "claude-code:claude-opus-5-5",
    "worker": "claude-code:claude-sonnet-5-5",
    "worker_permission": "workspace-write",
    "reviewer": "claude-code:claude-opus-5-5",
    "rater": "claude-code:claude-opus-5-5",
    "fixer": "claude-code:claude-opus-5-5",
    "max_cycles": "3"
  },
  "agent_contract": { "kind": "planner", "owns": "task", "may_spawn": true, "lateral_communication": "forbidden" },
  "isolation": { "repository": "independent-checkout" },
  "steps": [
    { "id": "task", "type": "automated", "run": "steps/setup.sh",
      "description": "Check the inputs; record the request and the base commit." },
    { "id": "plan", "type": "llm", "model": "{{ process.inputs.planner }}", "permission": "read-only",
      "workdir": "{{ process.inputs.workdir }}", "prompt_file": "prompts/dev-loop/plan.md", "timeout": "30m",
      "expected_output_schema": { "plan": { "type": "string", "required": true } } },
    { "id": "critique", "type": "llm", "model": "{{ process.inputs.critic }}", "permission": "read-only",
      "workdir": "{{ process.inputs.workdir }}", "prompt_file": "prompts/dev-loop/critique.md", "timeout": "20m",
      "expected_output_schema": { "critique": { "type": "string", "required": true } } },
    { "id": "final", "type": "llm", "model": "{{ process.inputs.planner }}", "permission": "read-only",
      "workdir": "{{ process.inputs.workdir }}", "prompt_file": "prompts/dev-loop/revise.md", "timeout": "20m",
      "expected_output_schema": { "plan": { "type": "string", "required": true }, "units": { "type": "array", "required": true } } },
    {
      "id": "cycle", "type": "loop",
      "loop": { "repeat_until": "steps.judge.outputs.done == 1", "max_iterations": "{{ process.inputs.max_cycles }}",
                "aggregate": { "done": "last" } },
      "body": [
        { "id": "todo", "type": "shell", "description": "Cycle 0 builds the plan's units; later cycles build the fix units.",
          "run": "jq -c 'if .loop.index == 0 then {units: .final.units} else {units: .fixes.units} end'" },
        {
          "id": "build", "type": "loop",
          "loop": { "for_each": "steps.todo.outputs.units[*]", "as": "unit", "max_iterations": 8, "aggregate": { "report": "concat" } },
          "body": [
            { "id": "work", "type": "llm", "model": "{{ process.inputs.worker }}", "permission": "{{ process.inputs.worker_permission }}",
              "workdir": "{{ process.inputs.workdir }}", "prompt_file": "prompts/worker.md", "timeout": "60m",
              "expected_output_schema": { "report": { "type": "string", "required": true } } }
          ]
        },
        { "id": "gate", "type": "automated", "run": "steps/gate.sh" },
        { "id": "diffs", "type": "automated", "run": "steps/diffs.sh" },
        { "id": "review", "type": "llm", "condition": "loop.index == 0", "model": "{{ process.inputs.reviewer }}", "permission": "read-only",
          "workdir": "{{ process.inputs.workdir }}", "prompt_file": "prompts/dev-loop/review.md", "timeout": "30m",
          "expected_output_schema": { "findings": { "type": "string", "required": true } } },
        { "id": "ratebrief", "type": "automated", "run": "steps/rate-brief.sh" },
        { "id": "rate", "type": "llm", "model": "{{ process.inputs.rater }}", "permission": "read-only",
          "workdir": "{{ process.inputs.workdir }}", "prompt": "{{ ratebrief.brief }}", "timeout": "30m",
          "expected_output_schema": { "findings": { "type": "string", "required": true },
                                      "blocking": { "type": "number", "required": true },
                                      "major": { "type": "number", "required": true } } },
        { "id": "judge", "type": "shell",
          "run": "jq -c '{done: (if .gate.passed == true and .rate.blocking == 0 and .rate.major == 0 then 1 else 0 end)}'" },
        { "id": "fixes", "type": "llm", "condition": "steps.judge.outputs.done == 0", "model": "{{ process.inputs.fixer }}", "permission": "read-only",
          "workdir": "{{ process.inputs.workdir }}", "prompt_file": "prompts/dev-loop/fixes.md", "timeout": "20m",
          "expected_output_schema": { "units": { "type": "array", "required": true } } }
      ]
    }
  ]
}
